<div class="flex h-screen overflow-hidden">
  <.admin_sidebar
    current_path={@current_path}
    counts={
      Map.merge(
        %{
          products: Kulola.Repo.aggregate(Kulola.Products.Product, :count),
          collections: Kulola.Repo.aggregate(Kulola.Collections.Collection, :count),
          bundles: Kulola.Repo.aggregate(Kulola.Bundles.Bundle, :count),
          orders: Map.get(Kulola.Orders.count_by_status(), "all", 0),
          customers: Kulola.Customers.count_customers(),
          promotions: Kulola.Promotions.count_promo_codes()
        },
        Map.get(assigns, :counts, %{})
      )
    }
  />
  <main class="flex-1 p-4 overflow-y-auto">
    {@inner_content}
  </main>
</div>
