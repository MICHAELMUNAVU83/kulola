<.header>
  Listing Bundles
  <:actions>
    <.link patch={~p"/bundles/new"}>
      <.button>New Bundle</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="bundles"
  rows={@streams.bundles}
  row_click={fn {_id, bundle} -> JS.navigate(~p"/bundles/#{bundle}") end}
>
  <:col :let={{_id, bundle}} label="Title">{bundle.title}</:col>
  <:col :let={{_id, bundle}} label="Description">{bundle.description}</:col>
  <:col :let={{_id, bundle}} label="Image">{bundle.image}</:col>
  <:action :let={{_id, bundle}}>
    <div class="sr-only">
      <.link navigate={~p"/bundles/#{bundle}"}>Show</.link>
    </div>
    <.link patch={~p"/bundles/#{bundle}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, bundle}}>
    <.link
      phx-click={JS.push("delete", value: %{id: bundle.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action in [:new, :edit]} id="bundle-modal" show on_cancel={JS.patch(~p"/bundles")}>
  <.live_component
    module={KulolaWeb.BundleLive.FormComponent}
    id={@bundle.id || :new}
    title={@page_title}
    action={@live_action}
    bundle={@bundle}
    patch={~p"/bundles"}
  />
</.modal>
